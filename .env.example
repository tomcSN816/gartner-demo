SN_INSTANCE="https://your-instance.service-now.com"
SN_USERNAME="admin"
# Escape any literal $ in secrets as \$ — Next.js's .env loader treats an
# unescaped $NAME as a variable reference and silently truncates the value.
SN_PASSWORD="your-password"

# URL embedded in an iframe on the /catalog page (ServiceNow catalog or Logik configurator)
NEXT_PUBLIC_CATALOG_EMBED_URL="https://your-instance.service-now.com/..."

# Used by src/middleware.js to proxy the ServiceNow web component (server-side only)
# SN_INSTANCE / SN_USERNAME / SN_PASSWORD above are required for the /catalog page.

# Logik tenant behind the CPQ configurator (sn_cpq_intg.tenant_url on the instance).
# Browser calls to it are routed through /logik/* to avoid cross-origin blocks.
NEXT_PUBLIC_LOGIK_TENANT_URL="https://your-tenant.demo01.logik.io"
